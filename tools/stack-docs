#!/usr/bin/env python3
"""Refresh the generated parts of the PR docs from stack.yml and the local
generated branches (run `stack-publish --write` first):

  - each PR page's header line (prs/pr-*.md): branch, base, size, files
    against canary;
  - each PR text's "### Depends on other PRs" section (pr-text/pr-*.md), with
    the upstream PR numbers from stack.yml.

  stack-docs           show which files would change
  stack-docs --write   write them
"""
import os
import re
import sys

from stacklib import HERE, git, load_stack

ROOT = os.path.dirname(HERE)
WRITE = '--write' in sys.argv
LIMIT = 300


def page_id(name):
    slug = name.split('/', 1)[1]
    return slug.split('-', 1)[0] if name.startswith('pr/') else name.replace('/', '-')


def titles():
    out = {}
    for line in open(os.path.join(ROOT, '_data/prs.yml')):
        m = re.match(r'\s+"([^"]+)": \{.*?title: "([^"]+)"', line)
        if m:
            out[m.group(1)] = m.group(2)
    return out


def short(b):
    # pr/19-todo-... -> pr/19; fix branches have no number, so keep the name
    if b == 'canary' or b.startswith('fix/'):
        return b
    return b.split('-')[0]


def header(name, bases):
    c = git('rev-parse', name)
    first_parent = git('rev-parse', f'{c}^')
    stat = git('diff', '--shortstat', first_parent, c)
    files = int(re.search(r'(\d+) files? changed', stat).group(1))
    ins = re.search(r'(\d+) insertion', stat)
    dels = re.search(r'(\d+) deletion', stat)
    nums = ' '.join(x for x in [f'+{int(ins.group(1)):,}' if ins else '',
                                f'−{int(dels.group(1)):,}' if dels else ''] if x)
    total = len(git('diff', '--name-only', 'upstream/canary', c).splitlines())
    line = f"Branch `{name}` · base `{' + '.join(short(b) for b in bases)}` · {files} files, {nums}"
    if total != files:
        line += f' · {total} files against canary'
    if total > LIMIT:
        line += f" (over CodeRabbit's {LIMIT})"
    return line


def depends(name, bases, by_name, names):
    if bases == ['canary']:
        return ('None. This applies straight onto `canary` and can be reviewed and merged on\n'
                'its own.\n')
    refs = []
    for b in bases:
        e = by_name[b]
        num = f"#{e['upstream']}" if e.get('upstream') else '(not yet opened)'
        refs.append(f"{num} ({names.get(page_id(b), b)})")
    compare_base = bases[-1]
    text = ('This is one PR in a stack from the [spmp/AFFiNE](https://github.com/spmp/AFFiNE) fork. '
            'Please merge\n' + ' and '.join(refs) + ' and the PRs they depend on first.\n\n'
            'A PR from a fork can only target `canary`, so GitHub also lists the commits\n'
            "of the PRs below this one. This PR's own change is its **last commit**. To\n"
            'see only that change:\n'
            f'https://github.com/spmp/AFFiNE/compare/{compare_base}...{name}\n\n'
            "Once the PRs below are merged, this PR's diff shrinks to that one commit.\n")
    return text


def main():
    cfg = load_stack()
    pub = [e for e in cfg['stack'] if e.get('publish')]
    by_name = {e['publish']: e for e in pub}
    names = titles()
    changed = []
    for e in pub:
        name = e['publish']
        if not git('rev-parse', '--verify', '--quiet', name, check=False):
            print(f'skip {name}: no local branch (run stack-publish --write)')
            continue
        bases = e.get('base', 'canary')
        bases = bases if isinstance(bases, list) else [bases]
        pid = page_id(name)

        page = os.path.join(ROOT, 'prs', f'pr-{pid}.md')
        if os.path.exists(page):
            s = open(page).read()
            s2 = re.sub(r'(?ms)^Branch `.*?(?=^\{: \.fs-3)', header(name, bases) + '\n', s, count=1)
            if s2 != s:
                changed.append(page)
                if WRITE:
                    open(page, 'w').write(s2)

        text = os.path.join(ROOT, 'pr-text', f'pr-{pid}.md')
        if os.path.exists(text):
            s = open(text).read()
            s2 = re.sub(r'(?ms)(^### Depends on other PRs\n\n).*?(?=^## )',
                        lambda m: m.group(1) + depends(name, bases, by_name, names) + '\n', s, count=1)
            base_note = ' + '.join(bases)
            s2 = re.sub(r'<!-- Open from: [^>]*-->',
                        f'<!-- Open from: spmp:{name} (generated by tools/stack-publish; one commit on {base_note}) -->', s2)
            if s2 != s:
                changed.append(text)
                if WRITE:
                    open(text, 'w').write(s2)
    for c in changed:
        print(('wrote ' if WRITE else 'would change ') + os.path.relpath(c, ROOT))
    if not changed:
        print('up to date')


main()
