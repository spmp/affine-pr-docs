#!/usr/bin/env python3
"""Measure how hard the stack is to rebase. Changes nothing.

  stack-check rehearsal [--weeks N] [RANGE ...]
      Replay each history (RANGE = base..tip; default: the working stack,
      upstream/canary..<top working branch>) commit by commit onto upstream
      canary as it was at the end of each of the last N weeks (default 8).
      Prints conflicting commits and files per week. Compare two candidate
      histories: fewer conflicts wins.

  stack-check overlap
      Files edited by more than one working branch (yarn.lock excluded).
      Each is a conflict waiting to happen when the lower branch changes.

See process/commits.md, "Measuring lumpiness".
"""
import sys
from collections import defaultdict

from stacklib import git, load_stack, merge_tree, working_parent


def snapshots(upstream, weeks):
    out = []
    for w in range(weeks, 0, -1):
        c = git('rev-list', '-1', '--first-parent', f'--before={w} weeks ago', upstream)
        if c and c not in out:
            out.append(c)
    out.append(git('rev-parse', upstream))
    return out


def rehearse(rng, snaps):
    base, tip = rng.split('..')
    commits = git('rev-list', '--reverse', '--no-merges', rng).split()
    print(f'\n{rng}: {len(commits)} commits')
    total = 0
    for s in snaps:
        cur, bad_commits, bad_files = s, 0, set()
        for c in commits:
            tree, conflicts = merge_tree(f'{c}^', cur, c)
            if conflicts:
                bad_commits += 1
                bad_files.update(conflicts)
            cur = git('commit-tree', tree, '-p', cur, '-m', 'rehearsal')
        total += bad_commits
        date = git('show', '-s', '--format=%cs', s)
        print(f'  onto canary {s[:10]} ({date}): {bad_commits:3d} conflicting commits, '
              f'{len(bad_files):3d} files' + (f'  e.g. {sorted(bad_files)[:3]}' if bad_files else ''))
    print(f'  total conflicting commit replays: {total}')
    return total


def overlap(cfg):
    stack = cfg['stack']
    upstream = f"upstream/{cfg.get('upstream_branch', 'canary')}"
    owners = defaultdict(list)
    for i, e in enumerate(stack):
        files = git('diff', '--name-only', working_parent(stack, i, upstream), e['working']).splitlines()
        for f in files:
            if f != 'yarn.lock':
                owners[f].append(e['working'].split('/', 2)[-1])
    shared = {f: o for f, o in owners.items() if len(o) > 1}
    for f, o in sorted(shared.items(), key=lambda x: -len(x[1])):
        print(f'{len(o)}  {f}\n     {", ".join(o)}')
    print(f'\n{len(shared)} files edited by more than one branch')


def main():
    args = sys.argv[1:]
    cfg = load_stack()
    upstream = f"upstream/{cfg.get('upstream_branch', 'canary')}"
    if not args or args[0] not in ('rehearsal', 'overlap'):
        sys.exit(__doc__)
    if args[0] == 'overlap':
        return overlap(cfg)
    weeks = 8
    if '--weeks' in args:
        weeks = int(args[args.index('--weeks') + 1])
        del args[args.index('--weeks'):args.index('--weeks') + 2]
    ranges = args[1:] or [f"{upstream}..{cfg['stack'][-1]['working']}"]
    snaps = snapshots(upstream, weeks)
    for r in ranges:
        rehearse(r, snaps)


main()
